# Production values only — copy to a protected deployment secret store, never
# commit the completed file. `npm run preflight:production` checks these rules.

# Workspace API
WORKSPACE_NODE_ENV=production
WORKSPACE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/garts_workspace?schema=public"
WORKSPACE_CORS_ORIGIN="https://workspace.example.org"
WORKSPACE_JWT_SECRET="generate-with-openssl-rand-base64-48"
WORKSPACE_BOOTSTRAP_SECRET="generate-a-separate-32-byte-secret"
WORKSPACE_CHAT_API_URL="http://chat-api:3001"
WORKSPACE_CHAT_SERVICE_TOKEN="generate-a-separate-service-token"
WORKSPACE_YOUTUBE_DATA_API_KEY="server-only-youtube-key"

# Chat API
CHAT_NODE_ENV=production
CHAT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/garts_chat?schema=public"
CHAT_REDIS_URL="rediss://:PASSWORD@HOST:6379"
CHAT_JWT_SECRET="generate-with-openssl-rand-base64-48"
CHAT_CORS_ORIGIN="https://chat.example.org"
CHAT_WORKSPACE_URL="https://workspace.example.org"
# Must exactly match WORKSPACE_JWT_SECRET and WORKSPACE_CHAT_SERVICE_TOKEN.
CHAT_WORKSPACE_JWT_SECRET="same-as-WORKSPACE_JWT_SECRET"
CHAT_WORKSPACE_SERVICE_TOKEN="same-as-WORKSPACE_CHAT_SERVICE_TOKEN"
