# ---------------------------------------------------------------------------
# G-Arts Chat — API configuration
#
# Copy to .env for local development. The server validates every value on boot
# and refuses to start in production with a weak or placeholder secret.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# SQLite is fine for a small team on one machine.
# For production, switch the datasource provider in prisma/schema.prisma to
# "postgresql" and point this at Postgres:
#   DATABASE_URL="postgresql://garts:PASSWORD@localhost:5432/garts_chat?schema=public"
DATABASE_URL="file:../../packages/chat-db/prisma/dev.db"

# Required in production. Without it, sessions are held in process memory:
# they vanish on restart and the server cannot run more than one instance.
# REDIS_URL="redis://localhost:6379"

# Generate with: openssl rand -base64 48
# Production boot fails if this is under 32 characters or still a placeholder.
JWT_SECRET=dev-only-secret-replace-before-any-real-deployment-000

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Exact browser origins, comma separated. No wildcards.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Attachment storage. Defaults to apps/api/uploads.
# UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=104857600

# Set false when the API is exposed directly rather than behind a proxy,
# so client IPs cannot be spoofed via X-Forwarded-For.
TRUST_PROXY=true

# Workspace integration. These values must match apps/api/.env.
WORKSPACE_URL=http://127.0.0.1:5174
WORKSPACE_JWT_SECRET=dev-only-replace-before-a-real-deployment-000000000000
WORKSPACE_SERVICE_TOKEN=dev-only-workspace-chat-service-token-000000000000
