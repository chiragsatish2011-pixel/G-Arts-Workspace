# Store completed production values in your deployment secret manager, not Git.
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/garts_chat?schema=public"
REDIS_URL="rediss://:PASSWORD@HOST:6379"
JWT_SECRET="generate-with-openssl-rand-base64-48"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN="https://chat.example.org"
TRUST_PROXY=true
WORKSPACE_URL="https://workspace.example.org"
WORKSPACE_JWT_SECRET="same-as-apps-api-JWT_SECRET"
WORKSPACE_SERVICE_TOKEN="same-as-apps-api-CHAT_SERVICE_TOKEN"
