{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run db:generate && npm run build --workspace=@g-arts/api && npm run build --workspace=@g-arts/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "NODE_ENV=development G_ARTS_SKIP_POSTINSTALL=1 npm ci --no-audit --no-fund",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
