{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=@g-arts/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "NODE_ENV=development G_ARTS_SKIP_POSTINSTALL=1 npm ci --no-audit --no-fund"
}
